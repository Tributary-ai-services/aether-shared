          "expr": "sum(sum_over_time({namespace=\"tas-llm-router\"} |= \"aiqg response event\" | json | tenant_id=~\"$tenant\" | vendor=~\"$vendor\" | unwrap total_cost_usd [$__range]))",
          "refId": "A"
        }
      ]
    },
    {

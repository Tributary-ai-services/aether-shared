            "displayName": "Request Rate"
          }
        ]
      },
      "pluginVersion": "9.5.2",
      "targets": [
        {
          "expr": "topk(10, sum by (provider) (rate(llm_router_requests_total{service=\"llm-router\"}[5m])))",
          "format": "table",
          "instant": true,
          "interval": "",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Top Providers by Request Rate",
      "transformations": [

    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Was 'Top Client IPs'. The client_ip label was removed from llm_router_requests_total: bounded only by the number of distinct callers, it is a cardinality hazard once traffic is real.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {

          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(llm_router_auth_attempts_total{service=\"llm-router\", result=\"success\"}[5m])",
          "legendFormat": "Successful Auth",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(llm_router_auth_attempts_total{service=\"llm-router\", result=\"failure\"}[5m])",
          "legendFormat": "Failed Auth",
          "refId": "B"
        }
      ],
      "title": "Authentication Rate",
